generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("postgresql://neondb_owner:***********@ep-sparkling-meadow-auj6tb2i-pooler.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require")
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  wallet Float @default(0) // This na where user money go dey
  orders Order[]
  createdAt DateTime @default(now())
}

model Order {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  type String // data, airtime, cable
  network String // mtn, glo, airtel, 9mobile
  phone String
  amount Float
  status String @default("pending") // success, failed
  ref String @unique
  createdAt DateTime @default(now())
}
