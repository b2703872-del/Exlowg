generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  wallet Float @default(0) // This na the money balance
  orders Order[]
  createdAt DateTime @default(now())
}

model Order {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  type String // data, airtime, cable
  network String // mtn, glo
  phone String
  amount Float
  status String @default("pending") // success, failed
  ref String @unique
  createdAt DateTime @default(now())
}
