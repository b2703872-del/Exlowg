generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("postgresql://neondb_owner:***********@ep-sparkling-meadow-auj6tb2i-pooler.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require")
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String? @unique
  password String
  role String @default("USER") // USER, ADMIN
  referralCode String @unique
  referredBy String?
  appPin String?
  transactionPin String?
  createdAt DateTime @default(now())
  wallet Wallet?
  transactions Transaction[]
  notifications Notification[]
  checkins Checkin[]
}

model Wallet {
  id String @id @default(cuid())
  userId String @unique
  balance Float @default(0)
  bonusBalance Float @default(0)
  user User @relation(fields: [userId], references: [id])
}

model Transaction {
  id String @id @default(cuid())
  userId String
  type String // DATA, AIRTIME, BILL, FUND, REFERRAL
  amount Float
  status String @default("PENDING") // PENDING, SUCCESS, FAILED
  details Json?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
}

model Plan {
  id String @id @default(cuid())
  network String // MTN, AIRTEL, GLO
  name String // 1GB SME
  size String // 1GB
  sellPrice Float
  costPrice Float
}

model Notification {
  id String @id @default(cuid())
  userId String
  title String
  message String
  read Boolean @default(false)
  type String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
}

model Checkin {
  id String @id @default(cuid())
  userId String
  day Int
  amount Float
  date DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
}
